    <!-- ImGui core and backends -->
    <ClCompile Include="Libraries\imgui-master\imgui.cpp" />
    <ClCompile Include="Libraries\ufbx\ufbx.c">
      <!-- Third-party C source: keep it compiling as C and out of the project's
           forced C++ prefix header (StdFirst.h), which is what made a plain C
           build fail with STL1003. -->
      <CompileAs>CompileAsC</CompileAs>
      <ForcedIncludeFiles>
      </ForcedIncludeFiles>
      <ConformanceMode>false</ConformanceMode>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="Libraries\imgui-master\imgui_draw.cpp" />
    <ClCompile Include="Libraries\ImGuizmo\ImGuizmo.cpp" />
    <ClCompile Include="Libraries\imgui-master\imgui_tables.cpp" />
    <ClCompile Include="Libraries\imgui-master\imgui_widgets.cpp" />
    <ClCompile Include="Libraries\imgui-master\backends\imgui_impl_win32.cpp" />
    <ClCompile Include="Libraries\imgui-master\backends\imgui_impl_dx12.cpp" />
    <!-- One ImGui renderer backend per configuration: RhiBuild.props makes the graphics backends
         mutually exclusive, and each of these needs a library (d3d11.lib / opengl32.lib) that only
         its own configuration links. The vendored sources have no RHI_* guards of their own, so the
         switch has to happen here rather than inside the file. -->
    <ClCompile Include="Libraries\imgui-master\backends\imgui_impl_dx11.cpp">
      <ExcludedFromBuild Condition="'$(EnableDirectX11Backend)'!='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="Libraries\imgui-master\backends\imgui_impl_vulkan.cpp">
      <ExcludedFromBuild Condition="'$(EnableVulkanBackend)'!='true'">true</ExcludedFromBuild>
    </ClCompile>
    <ClCompile Include="Libraries\imgui-master\backends\imgui_impl_opengl3.cpp">
      <ExcludedFromBuild Condition="'$(EnableOpenGLBackend)'!='true'">true</ExcludedFromBuild>
      <!-- This vendored backend parses the GL version string with sscanf/strcpy, which /sdl
           elevates from C4996 to an error. Relaxed here rather than by editing the upstream file,
           the same way ufbx.c is handled above. -->
      <SDLCheck>false</SDLCheck>
      <DisableSpecificWarnings>4996;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
